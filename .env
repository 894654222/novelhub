# =====================
# NovelHub Environment
# =====================


PROJECT_NAME=NovelHub


# PostgreSQL

POSTGRES_DB=novelhub

POSTGRES_USER=novelhub

POSTGRES_PASSWORD=change_me


DATABASE_URL=postgresql+asyncpg://novelhub:change_me@postgres:5432/novelhub



# Redis

REDIS_HOST=redis

REDIS_PORT=6379



# Meilisearch

MEILI_MASTER_KEY=change_me



# Backend

BACKEND_PORT=8000


# Frontend

FRONTEND_PORT=5173


# Timezone

TZ=Asia/Shanghai
# JWT

JWT_SECRET=change_this_secret


JWT_ALGORITHM=HS256


JWT_EXPIRE_MINUTES=1440



# Cookie encryption

COOKIE_SECRET=change_cookie_secret



# Meilisearch

MEILI_HOST=http://meilisearch:7700

MEILI_KEY=change_me



# Storage

STORAGE_PATH=/app/storage/books
